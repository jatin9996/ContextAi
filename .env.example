# Copy to .env in the repository root before starting the API.
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-string

DATABASE_URL=postgresql+asyncpg://contextai:contextai@localhost:5434/contextai
CORS_ORIGINS=http://localhost:3000,http://localhost:3002
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false

# embedded: the API process also runs the job worker (local demo)
# external: run `python -m app.workers.runner` separately (production)
WORKER_MODE=embedded

STORAGE_BACKEND=local
# STORAGE_PATH=C:/absolute/path/to/data/storage
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://localhost:9000
# S3_BUCKET=contextai
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_REGION=us-east-1

EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSIONS=384

# Leave blank to use evidence-only answers until a key is configured.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local demo only. Must be false in any shared environment.
# When SMTP_PASSWORD is set, reset and verification links are emailed and the token is not returned.
EXPOSE_DEV_TOKENS=true
REQUIRE_VERIFIED_EMAIL=false

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=jatinjadequest@gmail.com
SMTP_PASSWORD=
SMTP_FROM=jatinjadequest@gmail.com
WEB_BASE_URL=http://localhost:3002

NEXT_PUBLIC_API_URL=http://localhost:8000
